# Social Sanitation API environment. Copy to .env and fill in.
# src/config/env.schema.js checks every key at start-up: keys marked (required) must be set;
# an optional key left empty uses the default shown.

# --- App ---
# (required)
APP_NAME=social_sanitation
# (required) production, development or test
NODE_ENV=development
# default 5000
PORT=
# Server process time zone; keep UTC (default UTC)
DEFAULT_TIMEZONE=
# Time zone the business runs on: "today", weeks, months, cron jobs (default America/New_York)
BUSINESS_TIMEZONE=
# (required) Origins allowed to call the API, comma separated
ACCESSDOMAINS=http://localhost:3000,http://localhost:3001
# Public base URLs of this API and of the admin panel
API_BASE_URL=
ADMIN_BASE_URL=
# Default page size of list endpoints (default 15)
DEFAULT_API_DATA_LIMIT=
# Default amount of a new payment row (default 5)
DEFAULT_AMOUNT=
# Chrome binary for PDF generation; must match puppeteer-core's Chrome version
PUPPETEER_EXECUTABLE_PATH=
# Google Maps key used to read coordinates from map links
GOOGLE_API_KEY=

# --- Database (MySQL) ---
# (required) host, port, user and database name
CENTRAL_MYSQL_HOST=localhost
CENTRAL_MYSQL_PORT=3306
CENTRAL_MYSQL_USER=
CENTRAL_MYSQL_PASSWORD=
CENTRAL_MYSQL_DB=

# --- Sign-in tokens ---
# (required) Secret that signs admin and app tokens, hex
JWT_SECRET=
# (required) Days an app sign-in token is valid
JWT_ACCESS_EXPIRATION_DAYS=
# Days an admin sign-in token is valid (default 5)
JWT_ADMIN_ACCESS_EXPIRATION_DAYS=
# Days an admin password-reset token is valid (default 1)
JWT_ADMIN_RESET_EXPIRATION_DAYS=

# --- Roles and the first super admin (npm run auth) ---
SUP_ADM_ROLE_ID=1
ADM_ROLE_ID=2
USR_ROLE_ID=6
ADM_DEPT_ID=
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Firebase: chat database, push notifications, file storage ---
# (required) Service account; the private key on one line with \n for line breaks
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Default: the social-sanitation project's database and bucket
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# --- Mail (Microsoft Graph) ---
AZURE_TENANT_ID=
# (required) App registration client id and secret
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Mailbox emails are sent from
AZURE_SENDER_EMAIL=

# --- Square payments ---
# "production" for live payments; anything else uses the sandbox (default sandbox)
SQUARE_ENVIRONMENT=
SQUARE_ACCESS_TOKEN=
SQUARE_APP_ID=
SQUARE_LOCATION_ID=
# Webhook signature check (Square Developer portal > Webhooks > Signature key).
# SQUARE_WEBHOOK_URL must equal the notification URL registered with Square.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# --- DocuSign ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# RSA private key on one line with \n for line breaks
DOCUSIGN_PRIVATE_KEY=
# Default: the demo environment. Live: account.docusign.com and the account's base URI + /restapi
DOCUSIGN_OAUTH_BASE_PATH=
DOCUSIGN_BASE_PATH=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
