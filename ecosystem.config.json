{
  "apps": [
    {
      "name": "socialsanitation-backend",
      "script": "index.js",
      "cwd": "/var/www/socialsanitation/backend",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production"
      }
    },
    {
      "name": "socialsanitation-jobs",
      "script": "worker.js",
      "cwd": "/var/www/socialsanitation/backend",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "max_memory_restart": "1G",
      "kill_timeout": 35000,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
